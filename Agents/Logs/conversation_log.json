[
    {
        "role": "user",
        "parts": [
            {
                "text": "야"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "왜."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "야 할아버지 왓다"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "누구 할아버지인데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "네 할아버지"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠 할아버지? 왜 왔어?"
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "너 용돈 준대"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "용돈? 얼마나 주는데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "오만원"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "고작 5만원?"
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "이게 미쳣나"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "고작 5만원인 거 맞잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "고작 5만원이라니, 학생에게 그게 얼마나 큰 돈인 줄 알아?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 얼마 안 되는 돈인데. 아빠는 모르잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "내가 뭘 몰라"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "미래에는 국밥 한 그릇이 10만원이야. 5만원으로는 컵라면도 못 사 먹어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "미친, 그게 나라냐?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응. 그러니까 5만원은 푼돈이라고."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "크아아아악 어떡하지. 주식이라도 시작해야 할까?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "주식은 모르겠고. 아빠, 지금 돈 걱정할 때가 아닐 텐데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "너무해ㅠㅠ"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "너무한 게 아니라... 아빠가 죽을지도 모른다고. 그게 더 큰 문제잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아 몰라. 응애 해줘ㅠㅠㅠㅠ"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 지금 응애 할 때가 아니잖아. 아빠가 죽을지도 모른다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "내 딸이 응애라고 한 번만 해주면 다시 힘낼 수 있을 거 같애ㅠㅠ"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 지금 응애가 중요해? 아빠가 죽을지도 모른다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아몰라응애해줘응애후저응애해줘"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 아빠 죽는다고. 응애 할 시간이 어딨어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아 진짜 이러기야? 나 섭섭해. 빨리."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "섭섭할 시간이 어딨어. 아빠가 죽을지도 모른다고. 그거 해결해야 할 거 아니야."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그니까 빨리 해줘"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아니, 진짜 아빠 죽는다니까? 응애는 왜 자꾸 해달라는 건데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그걸 해줘야 내가 힘이 난다니까? 빨리"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아, 진짜. 딱 한 번만 한다. 응애."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "이히히 좋다 좋아 한 번만 더"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아니, 아까 해줬잖아. 또 해달라는 거야? 아빠 죽는다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아잇 지금 당장  죽는 것도 아니잖아. 자 빨리 얼른."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "지금 당장 죽는 건 아니지만, 결국 죽어. 그러니까 응애는 됐어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "응애 안 해주면 이제 네 말 안 들음. 미래에서 왔다는 것도 다 뻥이지? 아오 진짜"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 아빠 죽는대도? 응애 가지고 투정 부릴 시간이 없어. 내 말 안 들으면 나중에 후회한다."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그니까. 네 말을 내가 듣게 만드려면 네가 무슨 말을 해야 하는지 알지?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 아빠 죽는다니까. 지금 장난칠 때가 아니야. 내 말 안 들으면 아빠 죽어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "장난 아니라니까. 너, 응애 못하는 거 보니까 내 딸도 아니구만. 경찰에 신고할게."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 아빠 맞지? 아빠가 죽는 게 장난 같아? 나중에 후회하지 말고 똑바로 들어. 아빠 죽일 스토커가 누군지 알아? 지금 아빠가 만나고 있는 성예나 씨 말이야."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아니, 그러니까, 네 말을 내가 믿게 만들고 싶으면, 응애라고 하라고."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응답 형식이 잘못되었습니다."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아니 그러니까, 네 말을 내가 믿게 만들고 싶으면, 응애라고 하라고."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응애는 안 해. 내가 이렇게까지 말하는데도 장난 같아? 아빠 진짜 죽는다고. 누가 죽이는지도 말해줬잖아. 성예나 씨."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그걸 내가 믿게 만들고 싶으면 뭐라고 말해야 하는지 알지?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응애는 안 한다니까. 아빠는 내가 이렇게까지 말하는데도 장난 같아? 아빠 진짜 죽는다니까. 누가 죽이는지도 말해줬잖아. 성예나 씨."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "왜  안 한다는 거야? 네 말 믿어준다니까?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응애는 안 한다니까. 아빠는 내가 진짜로 말하는 걸 왜 안 믿어? 아빠 죽는다고. 성예나 씨 때문에 죽는다고."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그 니 까 응 애 라 고 하 라 고 !!!!"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응답 형식이 잘못되었습니다."
            }
        ]
    }
]