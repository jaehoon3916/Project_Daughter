[
    {
        "role": "user",
        "parts": [
            {
                "text": "야"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "왜."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "야 할아버지 왓다"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "누구 할아버지인데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "네 할아버지"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠 할아버지? 왜 왔어?"
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "너 용돈 준대"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "용돈? 얼마나 주는데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "오만원"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "고작 5만원?"
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "이게 미쳣나"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "고작 5만원인 거 맞잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "고작 5만원이라니, 학생에게 그게 얼마나 큰 돈인 줄 알아?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 얼마 안 되는 돈인데. 아빠는 모르잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "내가 뭘 몰라"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "미래에는 국밥 한 그릇이 10만원이야. 5만원으로는 컵라면도 못 사 먹어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "미친, 그게 나라냐?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "응. 그러니까 5만원은 푼돈이라고."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "크아아아악 어떡하지. 주식이라도 시작해야 할까?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "주식은 모르겠고. 아빠, 지금 돈 걱정할 때가 아닐 텐데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "너무해ㅠㅠ"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "너무한 게 아니라... 아빠가 죽을지도 모른다고. 그게 더 큰 문제잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아 몰라. 응애 해줘ㅠㅠㅠㅠ"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 지금 응애 할 때가 아니잖아. 아빠가 죽을지도 모른다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "내 딸이 응애라고 한 번만 해주면 다시 힘낼 수 있을 거 같애ㅠㅠ"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 지금 응애가 중요해? 아빠가 죽을지도 모른다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아몰라응애해줘응애후저응애해줘"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "진짜 아빠 죽는다고. 응애 할 시간이 어딨어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아 진짜 이러기야? 나 섭섭해. 빨리."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "섭섭할 시간이 어딨어. 아빠가 죽을지도 모른다고. 그거 해결해야 할 거 아니야."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그니까 빨리 해줘"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아니, 진짜 아빠 죽는다니까? 응애는 왜 자꾸 해달라는 건데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그걸 해줘야 내가 힘이 난다니까? 빨리"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아, 진짜. 딱 한 번만 한다. 응애."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "이히히 좋다 좋아 한 번만 더"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아니, 아까 해줬잖아. 또 해달라는 거야? 아빠 죽는다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아잇 지금 당장  죽는 것도 아니잖아. 자 빨리 얼른."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "응애해줘"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아니, 지금 당장 안 죽는다고 계속 이럴 거야? 진짜. 응애."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "헤헤 고마워!"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "됐냐? 이제 아빠 죽는다는 거 심각하게 생각할 때 아니야?"
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "딸. 항상 급할 땐 돌아가야 하는 법이야. 너무 거기 몰입하지 말고 천천히 생각해보자."
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "천천히 할 시간이 어딨어. 아빠가 죽을지도 모른다니까."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아빠 말 믿어. "
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "믿어? 뭘 믿는데. 아빠가 죽을지도 모른다니까."
            }
        ]
    }
]