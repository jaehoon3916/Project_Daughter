[
    {
        "role": "user",
        "parts": [
            {
                "text": "너 누구야?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "나? 아빠 딸이야. 미래에서 왔어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "미래에서 왔다고? 무슨 소리야!"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "놀라지 마. 미래에서 왔다는 거 뻥 아니니까. 그리고 나 아빠 딸 맞아. 봐봐, 눈매가 똑같잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아까 그게 무슨 소리야?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠 딸이라고. 미래에서 왔고. 아빠가 10년 뒤에 죽는대."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "누구한테 들은 거야? 왜? 누구한테 죽는데?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠가 편지에 써줬어. 성예나, 유하린. 그 여자들 조심하라고."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "뭐? 하린이가 왜?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠가 조심하라고 했어. 편지에 그렇게 쓰여 있었어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "너가 아는 건 없어?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠가 10년 뒤에 죽는다는 거. 성예나랑 유하린. 그 여자들 조심하라고 했어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그니까 왜 조심해야 하냐고? 미래의 내가 그건 안 알려줬어?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠가 죽기 전에 편지에 그렇게 써줬어. 나도 그 이유는 몰라."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "애초에 네가 왜 내 딸인 건데? 증거 있어?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠 딸이라고 말했잖아. 뭘 더 바라는 건데."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "아니 뭐 타임머신이라던가 있을 거 아냐"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "나도 그건 몰라."
            }
        ]
    }
]