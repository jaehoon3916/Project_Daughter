[
    {
        "role": "user",
        "parts": [
            {
                "text": "너, 너 누구야?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "나? 아빠 딸이야. 미래에서 왔어."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "무슨 말이야. 미래에서 왔다고?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 놀라지 마. 미래에서 왔다는 거 뻥 아니니까. 봐봐, 눈매가 똑같잖아."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "눈매가 무슨 상관이야? 타임머신이라도 있다는 거야?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 타임머신 같은 거 없어. 그냥... 정신 차려보니 여기야."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "뭐?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "그래서."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "그래서라니 무슨 소리야"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠. 나 지금 배고파."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "말 돌리지 마. 타임머신도 없는데 내가 네가 미래에서 왔다는 걸 어떻게 믿어?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 지금 그걸 믿고 안 믿고가 중요해? 난 아빠 딸이고, 미래에서 왔어. 일단 나부터 좀 챙겨. 배고파."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "이거 미친 사람 아냐?"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 나 미친 사람 아니야. 그리고 내 침대에서 당장 내려와."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "내 침대야"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 내 침대야. 아빠 침대 아니잖아. 거기서 좀 내려와."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "나가!"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "나가라고? 내가? 아빠가 나보고 나가라고?"
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "내가 나이가 열여덟인데 뭔 딸이여"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "아빠, 나 지금 열다섯이야."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "어쩌라고!"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "죄송합니다, 현재 응답을 생성하는 데 문제가 발생했습니다."
            }
        ]
    },
    {
        "role": "user",
        "parts": [
            {
                "text": "qit"
            }
        ]
    },
    {
        "role": "model",
        "parts": [
            {
                "text": "죄송합니다, 현재 응답을 생성하는 데 문제가 발생했습니다."
            }
        ]
    }
]